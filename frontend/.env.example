# Nothing is required for normal dev: Vite's proxy (vite.config.ts) forwards /api to the
# backend, so the frontend never needs the backend's address or any secret.
#
# VYOU_BACKEND_URL only matters if your backend isn't on the default http://localhost:8080.
# It is read by vite.config.ts as a shell variable, not a VITE_-prefixed one, so it is never
# bundled into the browser build.
# VYOU_BACKEND_URL=http://localhost:8080
#
# VITE_API_BASE_PATH is bundled into the build (it is a path, not a secret). Only change it if
# the production reverse proxy mounts the API somewhere other than /api.
# VITE_API_BASE_PATH=/api
